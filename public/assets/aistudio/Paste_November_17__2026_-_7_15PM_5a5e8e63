        toast: "रिव्यू कॉपी हो गया! अब Google पर 'Paste' दबाएं",
        openGoogle: 'Google खोलें',
        quickActions: 'त्वरित संपर्क और लोकेशन',
        call: 'कॉल',
        whatsapp: 'व्हाट्सएप',
        maps: 'मैप्स',
        google: 'गूगल',
      },
    };

    let currentLang = 'en';
    let currentTag = 'Pipe Leakage Repair';
    let currentStars = 5;
    let currentIndex = 0;

    const serviceTagsContainer = document.getElementById('service-tags');
    const textarea = document.getElementById('review-textarea');
    const refreshBtn = document.getElementById('refresh-review-btn');
    const copyBtn = document.getElementById('copy-paste-btn');
    const copyBtnLabel = document.getElementById('copy-btn-label');
    const copyToast = document.getElementById('copy-toast');
    const toastMessage = document.getElementById('toast-message');
    const toastOpenLink = document.getElementById('toast-open-link');
    const langEnBtn = document.getElementById('lang-en');
    const langHiBtn = document.getElementById('lang-hi');
    const taglineEl = document.getElementById('ui-tagline');
    const reviewLabelEl = document.getElementById('ui-review-label');
    const starBadgeScore = document.getElementById('star-badge-score');
    const quickActionsTitle = document.getElementById('quick-actions-title');
    const callLabel = document.getElementById('call-label');
    const whatsappLabel = document.getElementById('whatsapp-label');
    const mapsLabel = document.getElementById('maps-label');
    const googleLabel = document.getElementById('google-label');

    function renderServiceTags() {
      serviceTagsContainer.innerHTML = '';
      SERVICE_OPTIONS.forEach((opt) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = opt[currentLang];
        const isActive = opt.id === currentTag;
        btn.className = isActive
          ? 'service-tag px-3.5 py-2 rounded-full text-xs font-semibold border transition-colors whitespace-nowrap bg-[#F5F4EB] text-slate-950 border-[#F5F4EB] shadow-md'
          : 'service-tag px-3.5 py-2 rounded-full text-xs font-semibold border transition-colors whitespace-nowrap bg-[#0F213B] text-slate-200 border-[#F5F4EB]/20 hover:border-[#F5F4EB]/60';
        btn.addEventListener('click', () => {
          currentTag = opt.id;
          currentIndex = 0;
          renderServiceTags();
          updateReviewText();
        });
        serviceTagsContainer.appendChild(btn);
      });
    }

    function updateStarVisuals() {
      starBadgeScore.textContent = currentStars.toFixed(1) + ' ★';
      document.querySelectorAll('.star-btn').forEach((btn) => {
        const val = Number(btn.getAttribute('data-star'));
        const svg = btn.querySelector('svg');
        svg.setAttribute(
          'class',
          val <= currentStars
            ? 'w-7 h-7 text-[#F5F4EB] fill-[#F5F4EB]'
            : 'w-7 h-7 text-slate-600 fill-transparent'
        );
      });
    }

    function getActiveTagLabel() {
      const found = SERVICE_OPTIONS.find((item) => item.id === currentTag);
      return found ? found[currentLang] : currentTag;
    }

    function updateReviewText() {
      if (currentStars >= 5) {
        const list = reviews[currentLang][currentTag] || reviews.en['Pipe Leakage Repair'];
        textarea.value = list[currentIndex % list.length];
      } else {
        const label = getActiveTagLabel();
        const prefix = currentLang === 'hi'
          ? 'Plumber Wallace (' + label + '): '
          : 'Used Plumber Wallace for ' + label.toLowerCase() + '. ';
        const tail = currentLang === 'hi'
          ? (currentStars === 4 ? 'काम अच्छा और संतोषजनक रहा।' : 'सेवा का अनुभव साझा कर रहा हूँ।')
          : (currentStars === 4 ? 'Skilled technician, neat finish, and good overall service.' : 'Sharing honest feedback so the team can keep improving.');
        textarea.value = prefix + tail;
      }
    }

    function updateLanguageUI() {
      const t = uiText[currentLang];
      taglineEl.textContent = t.tagline;
      reviewLabelEl.textContent = t.reviewLabel;
      copyBtnLabel.textContent = t.copyBtn;
      toastMessage.textContent = t.toast;
      toastOpenLink.textContent = t.openGoogle;
      quickActionsTitle.textContent = t.quickActions;
      callLabel.textContent = t.call;
      whatsappLabel.textContent = t.whatsapp;
      mapsLabel.textContent = t.maps;
      googleLabel.textContent = t.google;

      if (currentLang === 'en') {
        langEnBtn.className = 'px-4 py-2 rounded-lg text-xs font-bold bg-[#F5F4EB] text-slate-950 transition-colors';
        langHiBtn.className = 'px-4 py-2 rounded-lg text-xs font-bold text-slate-300 hover:text-white transition-colors';
      } else {
        langHiBtn.className = 'px-4 py-2 rounded-lg text-xs font-bold bg-[#F5F4EB] text-slate-950 transition-colors';
        langEnBtn.className = 'px-4 py-2 rounded-lg text-xs font-bold text-slate-300 hover:text-white transition-colors';
      }

      renderServiceTags();
      updateReviewText();
    }

    function fallbackCopy(text) {
      const temp = document.createElement('textarea');
      temp.value = text;
      temp.setAttribute('readonly', '');
      temp.style.position = 'fixed';
      temp.style.top = '0';
      temp.style.left = '-9999px';
      temp.style.opacity = '0';
      document.body.appendChild(temp);
      temp.focus();
      temp.select();
      temp.setSelectionRange(0, temp.value.length);
      let ok = false;
      try {
        ok = document.execCommand('copy');
      } catch (err) {
        ok = false;
      }
      document.body.removeChild(temp);
      return ok;
    }

    function copyToClipboard(text) {
      let copied = false;
      const inIframe = window.self !== window.top;
      if (inIframe || !navigator.clipboard || !navigator.clipboard.writeText) {
        copied = fallbackCopy(text);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).catch(function () {
          if (!copied) fallbackCopy(text);
        });
      }
    }

    function fireCelebrationConfetti() {
      if (typeof window.confetti === 'function') {
        window.confetti({
          particleCount: 95,
          spread: 80,
          origin: { y: 0.65 },
          colors: ['#F5F4EB', '#22c55e', '#38bdf8', '#fb923c', '#ffffff'],
          disableForReducedMotion: true,
        });
      }
    }

    function openTargetInNewTab(url) {
      const a = document.createElement('a');
      a.href = url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }

    function handleCopyAndRedirectToGoogle() {
      copyToClipboard(textarea.value);
      fireCelebrationConfetti();
      copyToast.classList.remove('hidden');
      setTimeout(() => {
        openTargetInNewTab(GOOGLE_DIRECT_REVIEW_URL);
      }, 700);
      setTimeout(() => {
        copyToast.classList.add('hidden');
      }, 5000);
    }

    document.querySelectorAll('.star-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        currentStars = Number(btn.getAttribute('data-star')) || 5;
        currentIndex = 0;
        updateStarVisuals();
        updateReviewText();
      });
    });

    langEnBtn.addEventListener('click', () => {
      currentLang = 'en';
      currentIndex = 0;
      updateLanguageUI();
    });

    langHiBtn.addEventListener('click', () => {
      currentLang = 'hi';
      currentIndex = 0;
      updateLanguageUI();
    });

    refreshBtn.addEventListener('click', () => {
      currentIndex += 1;
      updateReviewText();
    });

    copyBtn.addEventListener('click', handleCopyAndRedirectToGoogle);

    updateLanguageUI();
  </script>
</body>
</html>